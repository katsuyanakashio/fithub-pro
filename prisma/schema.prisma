generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  emailVerified     Boolean   @default(false)
  name              String
  password          String
  phone             String?
  dateOfBirth       DateTime?
  gender            String?
  height            Float?
  weight            Float?
  role              String    @default("user")
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  stripeCustomerId  String?   @unique
  subscriptionId    String?
  subscriptionStatus String?  @default("inactive")
  consentGiven      Boolean   @default(false)
  consentDate       DateTime?
  dataRetention     Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?

  sessions          Session[]
  workouts          Workout[]
  nutritionLogs     NutritionLog[]
  wearableDevices   WearableDevice[]
  healthData        HealthData[]
  auditLogs         AuditLog[]
  payments          Payment[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workout {
  id          String   @id @default(uuid())
  userId      String
  title       String
  type        String
  duration    Int
  calories    Int
  distance    Float?
  intensity   String
  notes       String?
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises Exercise[]
}

model Exercise {
  id          String @id @default(uuid())
  workoutId   String
  name        String
  sets        Int
  reps        Int
  weight      Float?
  duration    Int?

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
}

model NutritionLog {
  id          String   @id @default(uuid())
  userId      String
  mealType    String
  foodName    String
  calories    Int
  protein     Float
  carbs       Float
  fat         Float
  fiber       Float?
  date        DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WearableDevice {
  id          String   @id @default(uuid())
  userId      String
  deviceType  String
  deviceName  String
  deviceId    String   @unique
  connected   Boolean  @default(false)
  lastSync    DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthData {
  id          String   @id @default(uuid())
  userId      String
  dataType    String
  value       Float
  unit        String
  source      String
  recordedAt  DateTime
  encrypted   Boolean  @default(true)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  resource    String
  ipAddress   String
  userAgent   String?
  status      String
  details     String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String   @id @default(uuid())
  userId          String
  stripePaymentId String   @unique
  amount          Int
  currency        String   @default("jpy")
  status          String
  description     String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}